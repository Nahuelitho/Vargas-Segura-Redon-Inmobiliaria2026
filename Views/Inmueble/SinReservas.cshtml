@model List<Inmueble>
@{ ViewData["Title"]="Inmuebles sin reservas"; int dias=ViewBag.Dias; }
<h1>Inmuebles sin reservas</h1><form method="get" class="row g-2 mb-3"><div class="col-auto"><label for="dias" class="form-label">Sin reservas en los últimos días</label><input id="dias" name="dias" type="number" min="1" max="3650" value="@dias" class="form-control" /></div><div class="col-auto align-self-end"><button class="btn btn-primary">Consultar</button></div></form><partial name="_TablaInmuebles" model="Model" /><a asp-action="InformeGeneral" class="btn btn-secondary">Volver a informes</a>
