@model BusquedaInmueblesFiltro
@{ ViewData["Title"]="Inmuebles libres entre fechas"; var inmuebles=ViewBag.Inmuebles as List<Inmueble>; }
<h1>Inmuebles libres entre fechas</h1><form method="get" class="card card-body mb-4"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label asp-for="FechaInicio" class="form-label"></label><input asp-for="FechaInicio" type="date" class="form-control" /><span asp-validation-for="FechaInicio" class="text-danger"></span></div><div class="col-md-4"><label asp-for="FechaFin" class="form-label"></label><input asp-for="FechaFin" type="date" class="form-control" /><span asp-validation-for="FechaFin" class="text-danger"></span></div><div class="col-md-4 align-self-end"><button class="btn btn-primary">Consultar</button></div></div></form>@if(inmuebles is not null){<partial name="_TablaInmuebles" model="inmuebles" />}<a asp-action="InformeGeneral" class="btn btn-secondary">Volver a informes</a>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
