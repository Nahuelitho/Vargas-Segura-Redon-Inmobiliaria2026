@model IEnumerable<Inmueble>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Dirección</th><th>Tipo</th><th>Propietario</th><th>Cupo</th><th>Precio/día</th><th>Oferta</th></tr></thead><tbody>@foreach(var i in Model){<tr><td><a asp-action="Detalles" asp-route-id="@i.Id">@i.Direccion</a></td><td>@i.Tipo?.Descripcion</td><td>@i.Propietario?.Apellido, @i.Propietario?.Nombre</td><td>@i.Cupo</td><td>@i.PrecioPorDia?.ToString("C")</td><td>@(i.Disponible?"Activa":"Suspendida")</td></tr>}@if(!Model.Any()){<tr><td colspan="6" class="text-center">No hay resultados.</td></tr>}</tbody></table></div>
