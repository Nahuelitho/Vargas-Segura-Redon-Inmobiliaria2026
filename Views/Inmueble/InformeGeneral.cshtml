@model List<Inmueble>
@{ ViewData["Title"]="Informe de inmuebles"; bool? disponible=ViewBag.Disponible; int pagina=ViewBag.Pagina, total=ViewBag.TotalPaginas; }
<h1>Informe: inmuebles y propietarios</h1><div class="mb-3 d-flex gap-2"><a asp-action="InformeGeneral" class="btn @(disponible is null ? "btn-primary":"btn-outline-primary")">Todos</a><a asp-action="InformeGeneral" asp-route-disponible="true" class="btn @(disponible == true ? "btn-primary":"btn-outline-primary")">Oferta activa</a><a asp-action="InformeGeneral" asp-route-disponible="false" class="btn @(disponible == false ? "btn-primary":"btn-outline-primary")">Suspendidos</a><a asp-action="InformePorPropietario" class="btn btn-outline-secondary">Por propietario</a><a asp-action="MasReservados" class="btn btn-outline-secondary">Más reservados</a><a asp-action="SinReservas" class="btn btn-outline-secondary">Sin reservas</a><a asp-action="Libres" class="btn btn-outline-secondary">Libres entre fechas</a></div><partial name="_TablaInmuebles" model="Model" />
@if(total>1){<nav class="mt-3">@for(var p=1;p<=total;p++){<a asp-route-disponible="@disponible" asp-route-pagina="@p" class="btn btn-sm @(p==pagina?"btn-primary":"btn-outline-primary")">@p</a>}</nav>}
