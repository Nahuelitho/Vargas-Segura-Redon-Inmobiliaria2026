@model Reserva
@{
    ViewData["Title"] = "Editar reserva";
}
<h1>Editar reserva</h1>
<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Editar" method="post"><input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="BuscarInquilino" class="form-label">Buscar por DNI o nombre</label>
                    <input id="BuscarInquilino" type="search" class="form-control mb-2"
                           placeholder="Buscar por DNI o nombre" maxlength="100" autocomplete="off"
                           data-busqueda-url="@Url.Action("Buscar", "Inquilino")"
                           data-busqueda-select="IdInquilino" aria-describedby="EstadoInquilino" />
                    <p id="EstadoInquilino" class="form-text" role="status" aria-live="polite">Escribí al menos 2 caracteres.</p>
                    <label asp-for="IdInquilino" class="form-label">Inquilino</label>
                    <select asp-for="IdInquilino" asp-items="ViewBag.Inquilinos" class="form-select">
                        <option value="">Seleccione...</option>
                    </select>
                    <span asp-validation-for="IdInquilino" class="text-danger"></span>
                </div>
                
                <div class="col-md-6">
                    <label for="BuscarInmueble" class="form-label">Buscar por dirección</label>
                    <input id="BuscarInmueble" type="search" class="form-control mb-2"
                           placeholder="Buscar por dirección" maxlength="100" autocomplete="off"
                           data-busqueda-url="@Url.Action("Buscar", "Inmueble")"
                           data-busqueda-select="IdInmueble" aria-describedby="EstadoInmueble" />
                    <p id="EstadoInmueble" class="form-text" role="status" aria-live="polite">Escribí al menos 2 caracteres.</p>
                    <label asp-for="IdInmueble" class="form-label">Inmueble</label>
                    <select asp-for="IdInmueble" asp-items="ViewBag.Inmuebles" class="form-select">
                        <option value="">Seleccione...</option>
                    </select>
                    <span asp-validation-for="IdInmueble" class="text-danger"></span>
                </div>
                
                <div class="col-md-4">
                    <label asp-for="FechaInicio" class="form-label">Fecha de inicio</label>
                    <input asp-for="FechaInicio" class="form-control" />
                    <span asp-validation-for="FechaInicio" class="text-danger"></span>
                </div>
                
                <div class="col-md-4">
                    <label asp-for="FechaFin" class="form-label">Fecha de fin</label>
                    <input asp-for="FechaFin" class="form-control" />
                    <span asp-validation-for="FechaFin" class="text-danger"></span>
                </div>
                
                <div class="col-md-4">
                    <label asp-for="MontoPorDia" class="form-label">Monto por día</label>
                    <input asp-for="MontoPorDia" class="form-control" />
                    <span asp-validation-for="MontoPorDia" class="text-danger"></span>
                </div>
                
                <div class="col-md-4">
                    <label asp-for="FechaTerminacion" class="form-label">Fecha de terminación</label>
                    <input asp-for="FechaTerminacion" class="form-control" />
                </div>
                
                <div class="col-md-4">
                    <label asp-for="Multa" class="form-label">Multa</label>
                    <input asp-for="Multa" class="form-control" />
                </div>
                
                <div class="col-md-4">
                    <label asp-for="IdReservaOrigen" class="form-label">Reserva de origen</label>
                    <input asp-for="IdReservaOrigen" class="form-control" />
                </div>
            </div>
            <div class="mt-4 text-end"><a asp-action="Index" class="btn btn-secondary">Cancelar</a><button
                class="btn btn-primary">Guardar cambios</button></div>
            </form>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }