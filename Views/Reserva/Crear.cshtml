@model Reserva

@{
    ViewData["Title"] = "Nueva reserva";
    var importeSena = ViewData.ModelState["importeSena"]?.AttemptedValue ?? string.Empty;
    var fechaPago = ViewData.ModelState["fechaPago"]?.AttemptedValue
        ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<h1>Nueva reserva</h1>

<div class="card shadow-sm">

    <div class="card-body">

        <form asp-action="Crear"
              method="post">

            <partial name="_Formulario"
                     model="Model" />

            <hr class="my-4" />

            <h5>Seña inicial</h5>

            <div class="row g-3">

                <div class="col-md-6">

                    <label class="form-label">
                        Importe de la seña
                    </label>

                    <input type="number"
                           name="importeSena"
                           step="0.01"
                           min="0"
                           class="form-control"
                           value="@importeSena" />

                    @Html.ValidationMessage(
                        "importeSena",
                        null,
                        new { @class = "text-danger" })

                </div>

                <div class="col-md-6">

                    <label class="form-label">
                        Fecha del pago
                    </label>

                    <input type="date"
                           name="fechaPago"
                           class="form-control"
                           value="@fechaPago" />

                    @Html.ValidationMessage(
                        "fechaPago",
                        null,
                        new { @class = "text-danger" })

                </div>

            </div>

            <div class="mt-4 text-end">

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Guardar reserva
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
