@model List<Reserva>
@{
    ViewData["Title"] = "Reserva";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Reservas</h1>
        <p class="text-muted mb-0">Administración de reservas</p>
    </div><a asp-action="Crear" class="btn btn-primary">Nueva reserva</a>
</div>
<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>Inquilino</th>
                <th>Inmueble</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Monto/día</th>
                <th></th>
            </tr>
        </thead>
        <tbody>@foreach(var r in Model){
            <tr>
                <td>@r.Inquilino?.Nombre @r.Inquilino?.Apellido</td>
                <td>@r.Inmueble?.Direccion</td>
                <td>@r.FechaInicio.ToShortDateString()</td>
                <td>@r.FechaFin.ToShortDateString()</td>
                <td>@r.MontoPorDia.ToString("C")</td>
                <td class="text-end"><a asp-action="Detalles" asp-route-id="@r.Id"
                                            class="btn btn-sm btn-outline-secondary">Detalles</a> <a asp-action="Editar"
                                                                             asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <form asp-action="Eliminar" asp-route-id="@r.Id" method="post" class="d-inline"><button
                        class="btn btn-sm btn-outline-danger"
                        onclick="return confirm('¿Eliminar esta reserva?')">Eliminar</button></form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center py-4">No hay reservas registradas.</td>
                </tr>
            }
        </tbody>
    </table>
</div>