@model IEnumerable<Reserva>

<h1>Reservas que terminan en los próximos @ViewBag.Dias días</h1>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="dias" class="form-label">Cantidad de días</label>
        <input id="dias" name="dias" type="number" min="0" value="@ViewBag.Dias" class="form-control" />
    </div>
    <div class="col-auto">
        <button class="btn btn-primary">Consultar</button>
    </div>
</form>

<table class="table table-striped">

    <thead>
        <tr>
            <th>Inquilino</th>
            <th>Inmueble</th>
            <th>Inicio</th>
            <th>Fin</th>
        </tr>
    </thead>

    <tbody>

    @foreach (var r in Model)
    {
        <tr>
            <td>
                @r.Inquilino?.Nombre
                @r.Inquilino?.Apellido
            </td>

            <td>
                @r.Inmueble?.Direccion
            </td>

            <td>
                @r.FechaInicio.ToString("dd/MM/yyyy")
            </td>

            <td>
                @r.FechaFin.ToString("dd/MM/yyyy")
            </td>
        </tr>
    }

    </tbody>

</table>
