@model Reserva

@{
    ViewData["Title"] = "Terminación anticipada";
}

<h1>Terminación anticipada</h1>

<div class="card shadow-sm">

    <div class="card-body">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <p>
            <strong>Inquilino:</strong>
            @Model.Inquilino?.Nombre
            @Model.Inquilino?.Apellido
        </p>

        <p>
            <strong>Inmueble:</strong>
            @Model.Inmueble?.Direccion
        </p>

        <p>
            <strong>Fecha original de finalización:</strong>
            @Model.FechaFin.ToString("dd/MM/yyyy")
        </p>

        <p>
            <strong>Monto por día:</strong>
            @Model.MontoPorDia?.ToString("C")
        </p>

        <div class="alert alert-warning mb-3">
            <div>
                Multa aplicable: <strong id="porcentaje-multa"></strong>
                del alquiler restante.
            </div>
            <div>
                Importe a cobrar: <strong id="importe-multa"></strong>
            </div>
            <small>
                Al confirmar, el pago de esta multa se registrará junto con la terminación.
            </small>
        </div>

        <form asp-action="Terminar"
              asp-route-id="@Model.Id"
              method="post">

            <div class="mb-3">

                <label class="form-label">
                    Fecha efectiva de terminación
                </label>

                <input type="date"
                       id="fecha-terminacion"
                       name="fechaTerminacion"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                       min="@Model.FechaInicio.ToString("yyyy-MM-dd")"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                       class="form-control"
                       required />

            </div>

            <a asp-action="Detalles"
               asp-route-id="@Model.Id"
               class="btn btn-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn btn-danger">
                Cobrar multa y finalizar
            </button>

        </form>

    </div>

</div>

@section Scripts {
    <script>
        (() => {
            const fecha = document.getElementById('fecha-terminacion');
            const importe = document.getElementById('importe-multa');
            const porcentaje = document.getElementById('porcentaje-multa');
            const inicio = new Date('@Model.FechaInicio.ToString("yyyy-MM-dd")T00:00:00');
            const fin = new Date('@Model.FechaFin.ToString("yyyy-MM-dd")T00:00:00');
            const montoPorDia = Number('@Model.MontoPorDia?.ToString(System.Globalization.CultureInfo.InvariantCulture)');
            const milisegundosPorDia = 24 * 60 * 60 * 1000;

            function actualizarMulta() {
                const efectiva = new Date(`${fecha.value}T00:00:00`);
                if (Number.isNaN(efectiva.getTime())) return;

                const diasTotales = Math.round((fin - inicio) / milisegundosPorDia);
                const diasTranscurridos = Math.round((efectiva - inicio) / milisegundosPorDia);
                const diasRestantes = Math.round((fin - efectiva) / milisegundosPorDia);
                const tasa = diasTranscurridos * 2 < diasTotales ? 0.50 : 0.25;
                const multa = diasRestantes * montoPorDia * tasa;

                porcentaje.textContent = `${tasa * 100}%`;
                importe.textContent = multa.toLocaleString('es-AR', {
                    style: 'currency',
                    currency: 'ARS'
                });
            }

            fecha.addEventListener('change', actualizarMulta);
            actualizarMulta();
        })();
    </script>
}
