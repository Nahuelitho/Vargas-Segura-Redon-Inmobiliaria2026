@model Reserva

<div asp-validation-summary="ModelOnly"
     class="text-danger">
</div>

<div class="row g-3">

    <div class="col-md-6">

        <label asp-for="IdInquilino"
               class="form-label">
            Inquilino
        </label>

        <input asp-for="IdInquilino" type="hidden" />
        <input id="buscar-inquilino"
               type="search"
               value="@ViewBag.InquilinoSeleccionado"
               placeholder="Buscar por nombre, apellido o DNI"
               autocomplete="off"
               class="form-control" />
        <div id="opciones-inquilino" class="list-group position-absolute z-3"></div>

        <span asp-validation-for="IdInquilino"
              class="text-danger">
        </span>

    </div>

    <div class="col-md-6">

        <label asp-for="IdInmueble"
               class="form-label">
            Inmueble
        </label>

        <input asp-for="IdInmueble" type="hidden" />
        <input id="buscar-inmueble"
               type="search"
               value="@ViewBag.InmuebleSeleccionado"
               placeholder="Buscar por dirección"
               autocomplete="off"
               class="form-control" />
        <div id="opciones-inmueble" class="list-group position-absolute z-3"></div>

        <span asp-validation-for="IdInmueble"
              class="text-danger">
        </span>

    </div>

    <div class="col-md-4">

        <label asp-for="FechaInicio"
               class="form-label">
            Fecha de inicio
        </label>

        <input asp-for="FechaInicio"
               type="text"
               asp-format="{0:dd/MM/yyyy}"
               placeholder="dd/mm/aaaa"
               maxlength="10"
               data-fecha-reserva
               class="form-control" />

        <span asp-validation-for="FechaInicio"
              class="text-danger">
        </span>

    </div>

    <div class="col-md-4">

        <label asp-for="FechaFin"
               class="form-label">
            Fecha de fin
        </label>

        <input asp-for="FechaFin"
               type="text"
               asp-format="{0:dd/MM/yyyy}"
               placeholder="dd/mm/aaaa"
               maxlength="10"
               data-fecha-reserva
               class="form-control" />

        <span asp-validation-for="FechaFin"
              class="text-danger">
        </span>

    </div>

    <div class="col-md-4">

        <label asp-for="MontoPorDia"
               class="form-label">
            Monto por día
        </label>

        <input asp-for="MontoPorDia"
               class="form-control" />

        <span asp-validation-for="MontoPorDia"
              class="text-danger">
        </span>

    </div>

</div>

<script>
    (() => {
        function activarBusqueda(nombre, entidad) {
            const texto = document.getElementById(`buscar-${nombre}`);
            const id = document.getElementById(`Id${nombre[0].toUpperCase()}${nombre.slice(1)}`);
            const opciones = document.getElementById(`opciones-${nombre}`);
            let espera;

            async function buscar() {
                const respuesta = await fetch('@Url.Action("Opciones", "Reserva")?entidad=' + entidad + '&termino=' + encodeURIComponent(texto.value));
                if (!respuesta.ok) return;
                const resultados = await respuesta.json();
                opciones.replaceChildren(...resultados.map(resultado => {
                    const boton = document.createElement('button');
                    boton.type = 'button';
                    boton.className = 'list-group-item list-group-item-action';
                    boton.textContent = resultado.texto;
                    boton.addEventListener('click', () => {
                        id.value = resultado.id;
                        texto.value = resultado.texto;
                        opciones.replaceChildren();
                    });
                    return boton;
                }));
            }

            texto.addEventListener('input', () => {
                id.value = '';
                clearTimeout(espera);
                espera = setTimeout(buscar, 250);
            });
            texto.addEventListener('focus', buscar);
        }

        activarBusqueda('inquilino', 'inquilinos');
        activarBusqueda('inmueble', 'inmuebles');
    })();
</script>
