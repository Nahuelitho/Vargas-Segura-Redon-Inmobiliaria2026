@{
    ViewData["Title"] = "Inicio";
}

<section class="py-4">
    <div class="p-4 p-md-5 mb-4 bg-light rounded-3 border">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold">Gestión inmobiliaria</h1>
            <p class="col-md-8 fs-5 text-muted">
                Administrá propietarios, inquilinos, inmuebles y reservas desde un solo lugar.
            </p>
            <a asp-controller="Inmueble" asp-action="Index" class="btn btn-primary btn-lg">Ver inmuebles</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Propietarios</h2>
                    <p class="text-muted">Alta, edición y consulta de propietarios.</p>
                    <a asp-controller="Propietario" asp-action="Index" class="btn btn-outline-primary">Ingresar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Inquilinos</h2>
                    <p class="text-muted">Registro y administración de inquilinos.</p>
                    <a asp-controller="Inquilino" asp-action="Index" class="btn btn-outline-primary">Ingresar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Reservas</h2>
                    <p class="text-muted">Control de períodos, montos y disponibilidad.</p>
                    <a asp-controller="Reserva" asp-action="Index" class="btn btn-outline-primary">Ingresar</a>
                </div>
            </div>
        </div>
    </div>
</section>
</div>
