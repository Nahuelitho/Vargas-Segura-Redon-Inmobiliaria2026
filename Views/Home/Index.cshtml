@{
    ViewData["Title"] = "Inicio";
}

<section class="inicio">
    <div class="inicio-presentacion">
        <div class="inicio-texto">
            <h1>Gestión inmobiliaria</h1>
            <p class="text-muted">
                Administrá propietarios, inquilinos, inmuebles y reservas desde un solo lugar.
            </p>
            <a asp-controller="Inmueble" asp-action="Index" class="btn btn-primary">Ver inmuebles</a>
        </div>
        <img class="inicio-ilustracion" src="~/images/gestion-inmobiliaria.png" asp-append-version="true" alt="Ilustración de casas y edificios con símbolos de propietarios, alquileres y reservas" width="1448" height="1086" fetchpriority="high" />
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="inicio-titulo-tarjeta">
                        <h2 class="h5">Propietarios</h2>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="7" r="4" /><path d="M3 21v-2a7 7 0 0 1 14 0v2M20 7v6m-3-3h6" /></svg>
                    </div>
                    <p class="text-muted">Alta, edición y consulta de propietarios.</p>
                    <a asp-controller="Propietario" asp-action="Index" class="btn btn-outline-primary">Gestionar Propietarios</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="inicio-titulo-tarjeta">
                        <h2 class="h5">Inquilinos</h2>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 22V2h14v20M2 22h20M10 22v-4h4v4M8 6h2m4 0h2M8 10h2m4 0h2M8 14h2m4 0h2" /></svg>
                    </div>
                    <p class="text-muted">Registro y administración de inquilinos.</p>
                    <a asp-controller="Inquilino" asp-action="Index" class="btn btn-outline-primary">Gestionar Inquilinos</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="inicio-titulo-tarjeta">
                        <h2 class="h5">Reservas</h2>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M7 2v6m10-6v6M3 11h18" /></svg>
                    </div>
                    <p class="text-muted">Control de períodos, montos y disponibilidad.</p>
                    <a asp-controller="Reserva" asp-action="Index" class="btn btn-outline-primary">Gestionar Reservas</a>
                </div>
            </div>
        </div>
    </div>
</section>
