@model List<TipoInmueble>
@{
    ViewData["Title"] = "Tipos de inmueble";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Tipos de inmueble</h1>
        <p class="text-muted mb-0">Administración de categorías</p>
    </div><a asp-action="Crear" class="btn btn-primary">Nuevo tipo</a>
</div>
<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>Descripción</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>@foreach(var tipo in Model){
            <tr>
                <td>@tipo.Descripcion</td>
                <td class="text-end"><a asp-action="Detalles" asp-route-id="@tipo.Id"
                                            class="btn btn-sm btn-outline-secondary">Detalles</a> <a asp-action="Editar"
                                                                             asp-route-id="@tipo.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <form asp-action="Eliminar" asp-route-id="@tipo.Id" method="post" class="d-inline"><button
                        class="btn btn-sm btn-outline-danger"
                        onclick="return confirm('¿Eliminar este tipo?')">Eliminar</button></form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="2" class="text-center py-4">No hay tipos registrados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>