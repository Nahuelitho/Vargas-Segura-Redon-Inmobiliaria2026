@model List<Inquilino>

@{
  ViewData["Title"] = "Inquilinos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Inquilinos</h1>
            <p class="text-muted mb-0">Administracion de inquilinos</p>
        </div>  
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>  
            Nuevo inquilino
        </a>
    </div>
    <div class="card shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0"> 
                    <thead class="table-dark">
                        <tr>
                            <th>DNI</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Telefono</th>
                            <th>Email</th>
                            <th>Direccion</th>
                            <th>Acciones</th>
                        </tr>    
                    </thead>  
                <tbody>
                    @if(Model.Any()){
                        @foreach(var inquilino in Model){
                            <tr>
                                <td>
                                    @if(!string.IsNullOrEmpty(inquilino.Dni)){
                                        <span class="fw-semibold">@inquilino.Dni</span>
                                    }else{
                                        <span class="text-muted">Sin DNI</span>
                                    }
                                </td>
                                <td>
                                    @if(!string.IsNullOrEmpty(inquilino.Nombre)){
                                        <span class="fw-semibold">@inquilino.Nombre</span>
                                    }else{
                                        <span class="text-muted">Sin nombre</span>
                                    }    
                                </td>
                                <td>
                                    @if(!string.IsNullOrEmpty(inquilino.Apellido)){
                                        <span class="fw-semibold">@inquilino.Apellido</span>
                                    }else{
                                        <span class="text-muted">Sin apellido</span>
                                    }    
                                </td>
                                <td>
                                    @if(!string.IsNullOrEmpty(inquilino.Telefono)){
                                        <span class="fw-semibold">@inquilino.Telefono</span>
                                    }else{
                                        <span class="text-muted">Sin telefono</span>
                                    }    
                                </td>
                                <td>
                                    @if(!string.IsNullOrEmpty(inquilino.Email)){
                                        <span class="fw-semibold">@inquilino.Email</span>
                                    }else{
                                        <span class="text-muted">Sin email</span>
                                    }    
                                </td>
                                <td>
                                    @if(!string.IsNullOrEmpty(inquilino.Direccion)){
                                        <span class="fw-semibold">@inquilino.Direccion</span>
                                    }else{
                                        <span class="text-muted">Sin direccion</span>
                                    }    
                                </td>
                                <td>
                                    <a asp-action="Update" asp-route-id="@inquilino.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                                    <form asp-action="Delete" asp-route-id="@inquilino.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Está seguro de que desea eliminar este inquilino?')">Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }else{
                        <tr>
                            <td colspan="7" class="text-center">No hay inquilinos</td>
                        </tr>
                    }    
                </tbody>
                </table>    
                <div class="d-flex justify-content-between mt-3">
                    <!-- Botón Anterior -->
                    @if ((int)ViewData["PaginaActual"] > 1)
                    {
                        <a asp-action="Index" asp-route-pagina="@((int)ViewData["PaginaActual"] - 1)" class="btn btn-primary">
                            &laquo; Anterior
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary" disabled>&laquo; Anterior</button>
                    }
                    <span>Página @ViewData["PaginaActual"]</span>
                    <!-- Botón Siguiente -->
                    @if ((bool)ViewData["TieneSiguiente"])
                    {
                        <a asp-action="Index" asp-route-pagina="@((int)ViewData["PaginaActual"] + 1)" class="btn btn-primary">
                            Siguiente &raquo;
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary" disabled>Siguiente &raquo;</button>
                    }
                </div>
            </div>    
        </div>
    </div>
</div>